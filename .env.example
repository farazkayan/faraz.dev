# Supabase configuration for Idea Vault
# SUPABASE_URL: Your Supabase project URL
# SUPABASE_KEY: Your Supabase anon/publishable key (for public inserts)
# SUPABASE_SERVICE_ROLE_KEY: Your Supabase service role key (for admin reads - server-side only)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin password for hidden terminal vault
ADMIN_PASSWORD="your-secure-admin-password"

# Session secret for cookie signing (server-side only)
# If not set, falls back to ADMIN_PASSWORD
# Generate a strong random string for production
ADMIN_SESSION_SECRET="your-strong-random-session-secret"